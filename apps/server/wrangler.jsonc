{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skill-studio-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "a6221d3398c2e695ab8e1a2f1237bd1b",
  "workers_dev": true,
  "routes": [{ "pattern": "api.useskillstudio.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      // Caps everything this Worker sends to skills.sh, whoever is calling.
      // skills.sh allows 600 requests/minute for the shared key, so a caller
      // that rotates egress IPs could otherwise spend the whole allowance and
      // take the Skill Store away from app users; 500 leaves room for the
      // local dev server, which spends the same key. Only cache misses count
      // against it.
      "name": "UPSTREAM_BUDGET",
      "namespace_id": "2",
      "simple": {
        "limit": 500,
        "period": 60,
      },
    },
  ],
}
