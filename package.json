{
  "name": "skill-studio-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w skill-studio",
    "dev:marketing": "npm run dev -w @skill-studio/marketing",
    "dev:server": "npm run dev -w @skill-studio/server",
    "build": "npm run build -w skill-studio",
    "build:marketing": "npm run build -w @skill-studio/marketing",
    "preview": "npm run preview -w skill-studio",
    "tauri": "npm run tauri -w skill-studio --",
    "typecheck": "npm run typecheck -w skill-studio",
    "typecheck:marketing": "npm run typecheck -w @skill-studio/marketing",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint --fix .",
    "lint:rust": "cd apps/desktop/src-tauri && cargo clippy -- -D warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fmt:rust": "cd apps/desktop/src-tauri && cargo fmt",
    "test": "npm run test:anti-slop && npm run test -w skill-studio && npm run test -w @skill-studio/lib && npm run test -w @skill-studio/server && npm run test -w @skill-studio/marketing",
    "test:anti-slop": "vitest run tools/oxlint/anti-slop/shared/dictionary-types.integration.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run doctor && npm run test && npm run types:check -w skill-studio && cd apps/desktop/src-tauri && cargo fmt --check && cargo clippy -- -D warnings && cargo test",
    "doctor": "react-doctor apps/desktop -y --no-score --no-supply-chain --blocking warning"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "@playwright/test": "^1.63.0",
    "react-doctor": "^0.9.12",
    "zod": "4.4.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
