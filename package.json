{
  "name": "skill-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint --fix .",
    "lint:rust": "cd src-tauri && cargo clippy -- -D warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fmt:rust": "cd src-tauri && cargo fmt",
    "check": "npm run typecheck && npm run lint && npm run format:check && cd src-tauri && cargo fmt --check && cargo clippy -- -D warnings && cargo test"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.6",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "diff": "^9.0.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.26.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "vite": "^5.4.21"
  }
}
