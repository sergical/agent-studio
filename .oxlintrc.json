{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    // React Compiler-family rules not already reached by categories.correctness
    // (exhaustive-deps, purity, preserve-manual-memoization, etc. are already
    // "error" via correctness). rules-of-hooks/hooks/no-deriving-state-in-effects
    // found zero violations in src, so they go straight to "error".
    "react/rules-of-hooks": "error",
    "react/hooks": "error",
    "react/no-deriving-state-in-effects": "error",
    // These fire on real code but the remaining findings need a human call
    // (e.g. an effect keyed off a value only to retrigger, not to read it,
    // or a raw useState setter deliberately named apart from a wrapped
    // callback of the same base name), so they stay "warn" until someone
    // works through them by hand instead of being silenced.
    "react/exhaustive-effect-dependencies": "error",
    "react/memo-dependencies": "error",
    "react/hook-use-state": "error",
    // This app has no server-rendered/cached data layer: every list comes
    // from a Tauri IPC call, which is exactly the "external system" the
    // rule's own guidance says effects should synchronize with. Turning
    // this on would force a rewrite of every data-fetching component for
    // no behavior change.
    "react/set-state-in-effect": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/dist", "**/node_modules", "**/src-tauri/target", "**/src-tauri/gen"]
}
