{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventDto",
  "description": "History row projected for display.",
  "type": "object",
  "properties": {
    "backup_dir": {
      "description": "Relative backup directory, when bytes were preserved.",
      "type": [
        "string",
        "null"
      ]
    },
    "drift": {
      "description": "Whether the touched files still match the recorded fingerprints.",
      "$ref": "#/$defs/DriftState"
    },
    "harness": {
      "description": "Harness, when harness-scoped.",
      "anyOf": [
        {
          "$ref": "#/$defs/AgentId"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "Id.",
      "$ref": "#/$defs/EventId"
    },
    "kind": {
      "description": "Kind, verbatim from the row.",
      "type": "string"
    },
    "project_path": {
      "description": "Project path, when project-scoped.",
      "type": [
        "string",
        "null"
      ]
    },
    "restore": {
      "description": "Whether restore is possible.",
      "$ref": "#/$defs/RestoreCapability"
    },
    "scope": {
      "description": "`global` or `project`.",
      "type": [
        "string",
        "null"
      ]
    },
    "skill": {
      "description": "Skill.",
      "$ref": "#/$defs/SkillName"
    },
    "status": {
      "description": "`pending`, `done`, `failed`, or `interrupted`.",
      "type": "string"
    },
    "ts": {
      "description": "Time.",
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "ts",
    "kind",
    "skill",
    "status",
    "restore",
    "drift"
  ],
  "$defs": {
    "AgentId": {
      "description": "Kebab-case harness identifier, for example `claude-code` or `open-code`.\n\nInvariant: the string is the serde wire name used by the desktop app\ntoday. `open-code` is canonical; `opencode` is only a CLI binary name and\nis never stored in an `AgentId`.",
      "type": "string"
    },
    "DriftState": {
      "description": "Whether the files an event touched still hold the bytes it recorded.",
      "oneOf": [
        {
          "description": "`list_events` did not compare fingerprints (the row has no inverse,\nor the caller did not ask).",
          "type": "string",
          "const": "unchecked"
        },
        {
          "description": "Live fingerprints match the recorded post-mutation fingerprints.",
          "type": "string",
          "const": "clean"
        },
        {
          "description": "At least one path changed since the event; restore needs `force`.",
          "type": "string",
          "const": "drifted"
        }
      ]
    },
    "EventId": {
      "description": "History event id (ULID string).\n\nInvariant: lexical order equals creation order inside one store.",
      "type": "string"
    },
    "RestoreCapability": {
      "description": "Whether a history event can be restored.",
      "oneOf": [
        {
          "description": "Restore is available.",
          "type": "object",
          "properties": {
            "restorable": {
              "type": "string",
              "const": "yes"
            }
          },
          "required": [
            "restorable"
          ]
        },
        {
          "description": "Already reverted by the named event.",
          "type": "object",
          "properties": {
            "by": {
              "description": "The restore event.",
              "$ref": "#/$defs/EventId"
            },
            "restorable": {
              "type": "string",
              "const": "reverted"
            }
          },
          "required": [
            "restorable",
            "by"
          ]
        },
        {
          "description": "The row has no inverse.",
          "type": "object",
          "properties": {
            "restorable": {
              "type": "string",
              "const": "no_inverse"
            }
          },
          "required": [
            "restorable"
          ]
        },
        {
          "description": "The row's kind is not known to this version of the core.",
          "type": "object",
          "properties": {
            "restorable": {
              "type": "string",
              "const": "unknown_kind"
            }
          },
          "required": [
            "restorable"
          ]
        }
      ]
    },
    "SkillName": {
      "description": "Lexical skill name: the directory name that holds `SKILL.md`.\n\nInvariant: two deployments with the same `SkillName` are the same skill,\neven when their bytes differ. A symlink alias with another name is another\nskill.",
      "type": "string"
    }
  }
}
